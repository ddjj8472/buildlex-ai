# Gemini (Google AI Studio). 없으면 검색 전용 모드로 동작합니다.
GEMINI_API_KEY=
# 답변 생성 모델 / 질의분석·재순위·평가용 빠른 모델
GEMINI_MODEL=gemini-3.1-flash-lite
GEMINI_FAST_MODEL=
# 임베딩(의미 검색) — npm run embed 로 색인을 만든 경우에만 사용됩니다.
GEMINI_EMBED_MODEL=gemini-embedding-001
GEMINI_EMBED_DIM=768
# 국가법령정보 Open API 인증키(OC). 별표 본문·법령해석례 실시간 조회에 사용 (https://open.law.go.kr)
LAW_API_OC=
# 1 이면 AI 호출 없이 모의 답변으로 화면을 확인합니다.
MOCK_LLM=
