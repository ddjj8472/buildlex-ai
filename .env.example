# Gemini (Google AI Studio). 없으면 검색 전용 모드로 동작합니다.
GEMINI_API_KEY=
# 답변 생성 모델 / 질의분석·재순위·평가용 빠른 모델
GEMINI_MODEL=gemini-3.1-flash-lite
GEMINI_FAST_MODEL=
# 기본 모델이 혼잡하거나 없을 때 순서대로 시도할 모델(쉼표 구분)
GEMINI_FALLBACK_MODELS=gemini-flash-latest,gemini-flash-lite-latest
# 임베딩(의미 검색) — npm run embed 로 색인을 만든 경우에만 사용됩니다.
GEMINI_EMBED_MODEL=gemini-embedding-001
GEMINI_EMBED_DIM=768
# 국가법령정보 Open API 인증키(OC). 별표 본문·법령해석례 실시간 조회에 사용 (https://open.law.go.kr)
LAW_API_OC=
# 1 이면 AI 호출 없이 모의 답변으로 화면을 확인합니다.
MOCK_LLM=
# 브이월드(V-World) 오픈API — /bim 지도에서 대지를 고르면 필지·토지이용계획·토지대장을 자동 조회합니다.
# 데이터 키는 서버에서만 씁니다. DOMAIN은 키 발급 때 등록한 서비스 URL과 같아야 합니다(예: https://buildlex-ai.vercel.app).
VWORLD_API_KEY=
VWORLD_DOMAIN=
# (선택) 지도 배경·지적도·용도지역 레이어용 키. 브라우저에 노출되니 도메인 제한 키를 쓰세요. 없으면 OpenStreetMap.
VWORLD_MAP_KEY=
